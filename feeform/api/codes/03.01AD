{"code":{"hsc":"03.01AD","title":"Patient-initiated advice by phone, secure email, or videoconference","description":"Advice to a patient or their agent via telephone, secure email, or videoconference.","baseRateCents":2000,"currency":"CAD","effectiveDate":"2026-04-01","providerTypes":["family_physician"],"category":"virtual","careSetting":["unknown"],"modality":["phone","video","secure_message"],"requiresPatientPresent":false,"requiresStartStopTime":false,"maxCallsPerDay":1,"compatibleModifierCodes":[],"incompatibleHscs":["03.03CV"],"governingRuleIds":["GR-TELEPHONE-LOCATION"],"documentationRequirements":["Confirm the service was initiated by the patient or their agent.","Confirm the service is not being claimed through a third-party contract.","Confirm no same-day incompatible virtual or in-person service is being claimed by the same physician for the same patient."],"sourceRefs":[{"sourceType":"SOMB_PROCEDURE_LIST","title":"Medical procedure list as of 01 April 2026","effectiveDate":"2026-04-01","url":"https://open.alberta.ca/dataset/1f1d0cc4-cbaa-4793-9b4e-25a4d6f07cac/resource/7768a642-91ac-44b9-9f92-c13f23fc069d/download/pphs-somb-medical-procedure-list-2026-04.pdf","page":39,"section":"03.01AD"}],"qaStatus":"manual_reviewed"}}