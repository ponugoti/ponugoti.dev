{"code":{"hsc":"03.03CV","title":"Limited assessment - phone or secure videoconference","description":"Assessment of a patient's condition via telephone or secure videoconference.","baseRateCents":2509,"currency":"CAD","effectiveDate":"2026-04-01","providerTypes":["family_physician"],"category":"virtual","careSetting":["clinic","unknown"],"modality":["phone","video"],"requiresPatientPresent":true,"requiresStartStopTime":true,"minDurationMinutes":10,"compatibleModifierCodes":["CMGP","CMXV20","CMXV35"],"incompatibleHscs":["03.01AD","03.03A","03.04A"],"governingRuleIds":["GR-TELEPHONE-LOCATION"],"documentationRequirements":["Document services provided, total physician time, and start and stop times.","Document history related to presenting problems, appropriate records, and advice to patient.","Confirm the same physician is not claiming an in-person visit for the same patient on the same day."],"sourceRefs":[{"sourceType":"SOMB_PROCEDURE_LIST","title":"Medical procedure list as of 01 April 2026","effectiveDate":"2026-04-01","url":"https://open.alberta.ca/dataset/1f1d0cc4-cbaa-4793-9b4e-25a4d6f07cac/resource/7768a642-91ac-44b9-9f92-c13f23fc069d/download/pphs-somb-medical-procedure-list-2026-04.pdf","page":58,"section":"03.03CV"}],"qaStatus":"manual_reviewed"}}